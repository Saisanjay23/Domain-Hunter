# Copy this file to ".env" and fill in the keys you have. Every key is optional:
# the hunt uses whichever sources are configured and skips the rest.
# Keys stay on this machine. The web UI (Settings > API keys) only ever shows the last 4 characters.
#
# Several keys per source are supported, comma-separated: SHODAN_API_KEY=key1,key2,key3
# The first is used until it is rate-limited or out of quota, then the next one takes over.

# URLScan works without a key (rate-limited); a free key raises the limits.
URLSCAN_API_KEY=

# Shodan: favicon-hash / title / HTML searches need a paid membership (filters).
SHODAN_API_KEY=

# FOFA: key from your FOFA profile. FOFA_EMAIL only for older accounts that still need it.
FOFA_KEY=
FOFA_EMAIL=

# Censys Platform: personal access token (needs the API Access role).
# CENSYS_ORG_ID only if your account belongs to an organisation.
CENSYS_PAT=
CENSYS_ORG_ID=

# Storage: leave empty to keep history in the local SQLite file (data/hunter.db).
# Set a MongoDB connection string to store hunts, case notes, the watchlist and alerts in MongoDB instead.
# Easiest from the web UI: Settings > Storage (it tests the connection before saving).
#   local:  mongodb://127.0.0.1:27017
#   Atlas:  mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/   (percent-encode special characters in the password)
MONGODB_URI=
MONGODB_DB=

# SerpApi: automated Google Lens reverse image search of the brand logo.
SERPAPI_KEY=
