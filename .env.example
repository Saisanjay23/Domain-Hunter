# Free mode (default ON): only free sources are used. Paid platforms (Shodan, FOFA, Censys, SerpApi / Google Lens,
# WhoisXML) are never called, even if a key is saved below, and URLScan queries are kept within its free plan.
# Set FREE_ONLY_MODE=0 only if you have paid plans and want them used.
FREE_ONLY_MODE=1

# Copy this file to ".env" and fill in the keys you have. Every key is optional:
# the hunt uses whichever sources are configured and skips the rest.
# Keys stay on this machine. The web UI (Settings > API keys) only ever shows the last 4 characters.
#
# Several keys per source are supported, comma-separated: SHODAN_API_KEY=key1,key2,key3
# The first is used until it is rate-limited or out of quota, then the next one takes over.

# URLScan works without a key (rate-limited); a free key raises the limits.
URLSCAN_API_KEY=

# Shodan: favicon-hash / title / HTML searches need a paid membership (filters).
SHODAN_API_KEY=

# FOFA: key from your FOFA profile. FOFA_EMAIL only for older accounts that still need it.
FOFA_KEY=
FOFA_EMAIL=

# Censys Platform: personal access token (needs the API Access role).
# CENSYS_ORG_ID only if your account belongs to an organisation.
CENSYS_PAT=
CENSYS_ORG_ID=

# Storage: MongoDB is the only database (hunts, case notes, watchlist, alerts, scan batches, findings).
# Leave empty to use the local server mongodb://127.0.0.1:27017 (database "brand_hunter").
# Easiest from the web UI: Settings > Storage (it tests the connection before saving).
#   local:  mongodb://127.0.0.1:27017
#   Atlas:  mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/   (percent-encode special characters in the password)
MONGODB_URI=
MONGODB_DB=

# Scan Scheduler (runs inside the web server process; set to 0 to disable all background scheduling)
# BRAND_HUNTER_SCHEDULER=1
# Parallel domain scans per batch execution (1-6) and per-domain scan timeout in seconds
# SCHEDULER_CONCURRENCY=2
# SCHEDULER_JOB_TIMEOUT=900

# SerpApi: automated Google Lens reverse image search of the brand logo.
SERPAPI_KEY=

# WhoisXML API: Brand Alert (daily newly registered/updated lookalikes + typos) & Domain Discovery.
WHOISXML_API_KEY=

# VirusTotal (optional, free key works): keyword search plus a per-domain reputation check of the most suspicious
# candidates. Free tier = 4 lookups/minute, so a hunt checks at most 12 domains and stops cleanly when rate limited.
VIRUSTOTAL_API_KEY=

# Google Safe Browsing (optional): one batched check of every candidate against Google's phishing/malware lists.
# Google's terms limit the Lookup API v4 to NON-COMMERCIAL use; commercial deployments should use Google Web Risk.
GOOGLE_SAFE_BROWSING_KEY=

# AlienVault OTX passive DNS works without a key (rate-limited); a free OTX key raises the limits.
OTX_API_KEY=

# "Brand + malicious context" words (login, verify, wallet, payment, ...). Plain words are ADDED to the defaults,
# "-word" removes one. GET /api/scoring-weights lists the effective words.
#   LURE_KEYWORDS=invoice,crypto,-help
LURE_KEYWORDS=

# Threat-score tuning (optional JSON). Every signal's points and the verdict thresholds can be overridden;
# unknown names and values outside 0-100 are ignored. See GET /api/scoring-weights for all names and defaults.
#   THREAT_SCORE_WEIGHTS={"age_30": 25, "feed": 50, "thresholds": {"phishing": 75, "suspicious": 40}}
THREAT_SCORE_WEIGHTS=
